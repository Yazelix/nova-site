---
import { frontmatter as novaV1 } from '../../../drafts/yazelix-nova-v1.md';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHead from '../../components/SiteHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/home.css';

const posts = [
	{
		href: `/blog/${novaV1.proposedSlug}/`,
		title: novaV1.title,
		description: novaV1.description,
		release: novaV1.release,
		image: novaV1.previewImage,
		imageAlt: novaV1.previewImageAlt,
	},
];

for (const post of posts) {
	if (!post.image || !post.imageAlt) {
		throw new Error(`blog preview is missing an image: ${post.href}`);
	}
}
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Blog"
			description="Read Yazelix Nova v1: the terminal workspace I use every day."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="blog" />
			<main id="main-content" class="section" style="padding-top: 8rem;" tabindex="-1">
				<div class="section-inner">
					<h1 style="font-size: clamp(2.7rem, 7vw, 5rem);">Yazelix Blog</h1>
					<p class="section-lede">
						Source-backed writing about Yazelix Nova
					</p>
					<div class="blog-grid blog-preview-grid">
						{
							posts.map((post) => (
								<article class="panel blog-post-card">
									<a class="blog-post-card-link" href={post.href}>
										<div class="blog-post-card-media">
											<img
												src={post.image}
												alt={post.imageAlt}
												width="1784"
												height="996"
												decoding="async"
											/>
										</div>
										<div class="blog-post-card-body">
											<p class="eyebrow">{post.release}</p>
											<h2>{post.title}</h2>
											<p>{post.description}</p>
											<span class="blog-read-link">Read the article</span>
										</div>
									</a>
								</article>
							))
						}
					</div>
				</div>
			</main>
			<SiteFooter />
		</div>
	</body>
</html>
