---
import { getCollection } from 'astro:content';
import SiteHead from '../../components/SiteHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/home.css';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead title="Yazelix Blog" description="Release essays, design notes, and product writing for Yazelix." />
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="blog" />
			<main id="main-content" class="section" style="padding-top: 8rem;" tabindex="-1">
				<div class="section-inner">
					<h1 style="font-size: clamp(2.7rem, 7vw, 5rem);">Yazelix Blog</h1>
					<p class="section-lede">
						Release essays, design notes, and product writing for people following the Yazelix workspace.
					</p>
					<div class="blog-grid">
						{
							posts.map((post) => (
								<article class="panel">
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
									<p>{post.data.pubDate.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
									<a href={`/blog/${post.id}/`}>Read post</a>
								</article>
							))
						}
					</div>
				</div>
			</main>
		</div>
	</body>
</html>
