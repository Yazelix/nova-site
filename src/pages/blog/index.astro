---
import { frontmatter as novaV1 } from '../../../drafts/yazelix-nova-v1.md';
import SiteHead from '../../components/SiteHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Blog"
			description="Read Yazelix Nova v1: the terminal workspace behind yzx."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="blog" />
			<main id="main-content" class="section" style="padding-top: 8rem;" tabindex="-1">
				<div class="section-inner">
					<h1 style="font-size: clamp(2.7rem, 7vw, 5rem);">Yazelix Blog</h1>
					<p class="section-lede">
						Source-backed writing about Yazelix Nova.
					</p>
					<div class="blog-grid blog-preview-grid">
						<article class="panel blog-post-card">
							<p class="eyebrow">{novaV1.release}</p>
							<h2><a href={`/blog/${novaV1.proposedSlug}/`}>{novaV1.title}</a></h2>
							<p>{novaV1.description}</p>
							<a class="blog-read-link" href={`/blog/${novaV1.proposedSlug}/`}>Read the article</a>
						</article>
					</div>
				</div>
			</main>
		</div>
	</body>
</html>
