---
import SiteHead from '../../components/SiteHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Blog"
			description="Yazelix has not published Blog articles yet. The first article will cover Yazelix Nova v1."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="blog" />
			<main id="main-content" class="section" style="padding-top: 8rem;" tabindex="-1">
				<div class="section-inner">
					<h1 style="font-size: clamp(2.7rem, 7vw, 5rem);">Yazelix Blog</h1>
					<p class="section-lede">
						We will publish Yazelix Nova release notes and design writing here after we review each draft.
					</p>
					<section class="panel" style="max-width: 44rem; margin-top: 2rem;" aria-labelledby="empty-blog-title">
						<h2 id="empty-blog-title">No articles yet</h2>
						<p>Yazelix Nova v1 will be the first subject.</p>
						<p>Until then, use the Nova docs for supported commands and runtime behavior.</p>
						<a href="/docs/">Read the Nova docs</a>
					</section>
				</div>
			</main>
		</div>
	</body>
</html>
