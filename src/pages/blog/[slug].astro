---
import { getCollection, render } from 'astro:content';
import SiteHead from '../../components/SiteHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/home.css';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead title={`${post.data.title} - Yazelix Blog`} description={post.data.description} type="article" />
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="blog" />
			<main id="main-content" class="section" style="padding-top: 8rem;" tabindex="-1">
				<article class="section-inner" style="max-width: 780px;">
					<p class="eyebrow">{post.data.pubDate.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric' })}</p>
					<h1 style="font-size: clamp(2.4rem, 6vw, 4.2rem);">{post.data.title}</h1>
					<p class="section-lede">{post.data.description}</p>
					<div class="sl-markdown-content" style="margin-top: 2rem;">
						<Content />
					</div>
				</article>
			</main>
		</div>
	</body>
</html>
