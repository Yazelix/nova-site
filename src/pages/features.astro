---
import FeatureMediaFrame from '../components/FeatureMediaFrame.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { featureMediaGroups } from '../data/feature_media';
import '../styles/home.css';

const demoCount = featureMediaGroups.reduce((count, group) => count + group.items.length, 0);
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Nova Features - Visual tour"
			description="A focused visual tour of the maintained Yazelix Nova workspace."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="features" />

			<main id="main-content" class="feature-page" tabindex="-1">
				<section class="feature-intro">
					<div class="section-inner">
						<p class="eyebrow">{demoCount} visual demos</p>
						<h1>Yazelix Nova features</h1>
						<p class="hero-copy">
							One current workspace, viewed at the levels that matter: the full composition, file-first
							navigation, visible runtime identity, and keyboard controls.
						</p>
						<div class="hero-actions">
							<a class="button primary" href="/start/">Start with Yazelix</a>
							<a class="button secondary" href="/docs/">Read the docs</a>
						</div>
					</div>
				</section>

				{
					featureMediaGroups.map((group, index) => (
						<section class:list={['section', index % 2 === 1 && 'strip']}>
							<div class="section-inner">
								<div class="section-heading-row">
									<div>
										<p class="eyebrow">{group.items.length} demos</p>
										<h2>{group.title}</h2>
										<p class="section-lede">{group.summary}</p>
									</div>
								</div>
								<div class="feature-gallery">
									{group.items.map((item) => (
										<FeatureMediaFrame item={item} />
									))}
								</div>
							</div>
						</section>
					))
				}
			</main>
		</div>
	</body>
</html>
