---
import FeatureMediaFrame from '../components/FeatureMediaFrame.astro';
import HomeWatchClip from '../components/HomeWatchClip.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { featureMediaGroups } from '../data/feature_media';
import { homeWatchClips } from '../data/home_watch';
import '../styles/home.css';

const stillCount = featureMediaGroups.reduce((count, group) => count + group.items.length, 0);
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Nova Features - Visual tour"
			description="A focused visual tour of the maintained Yazelix Nova workspace."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="features" />

			<main id="main-content" class="feature-page" tabindex="-1">
				<section class="feature-intro">
					<div class="section-inner">
						<p class="eyebrow">{homeWatchClips.length} clips, {stillCount} still views</p>
						<h1>Yazelix Nova features</h1>
						<p class="hero-copy">
							Short loops of tabs, stacked panes, and live config, then one current workspace in four
							still views: the full composition, file-first navigation, runtime identity, and keyboard
							controls.
						</p>
						<div class="hero-actions">
							<a class="button primary" href="/start/">Start with Yazelix</a>
							<a class="button secondary" href="/docs/">Read the docs</a>
						</div>
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<div class="section-heading-row">
							<div>
								<p class="eyebrow">{homeWatchClips.length} clips</p>
								<h2>Watch what it does</h2>
								<p class="section-lede">
									Three moments from the v1 walkthrough. See the
									<a href="/blog/yazelix-nova-v1/">full 54 seconds</a>.
								</p>
							</div>
						</div>
						<div class="feature-gallery">
							{homeWatchClips.map((clip) => <HomeWatchClip clip={clip} />)}
						</div>
					</div>
				</section>

				{
					featureMediaGroups.map((group) => (
						<section class="section">
							<div class="section-inner">
								<div class="section-heading-row">
									<div>
										<p class="eyebrow">{group.items.length} stills</p>
										<h2>{group.title}</h2>
										<p class="section-lede">{group.summary}</p>
									</div>
								</div>
								<div class="feature-gallery">
									{group.items.map((item) => (
										<FeatureMediaFrame item={item} />
									))}
								</div>
							</div>
						</section>
					))
				}
			</main>
		</div>
	</body>
</html>
