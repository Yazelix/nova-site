---
import FeatureMediaFrame from '../components/FeatureMediaFrame.astro';
import HomeWatchClip from '../components/HomeWatchClip.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { workspaceStill } from '../data/feature_media';
import { paneClips, popupClips } from '../data/home_watch';
import '../styles/home.css';

const clipCount = paneClips.length + popupClips.length;
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Nova Features - Visual tour"
			description="A focused visual tour of the maintained Yazelix Nova workspace."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="features" />

			<main id="main-content" class="feature-page" tabindex="-1">
				<section class="feature-intro">
					<div class="section-inner">
						<p class="eyebrow">{clipCount} clips, one workspace still</p>
						<h1>Yazelix Nova features</h1>
						<p class="hero-copy">
							The tiled workspace, then the Yazelix popup layer: files, git, the agent, live config, and
							Anima
						</p>
						<div class="hero-actions">
							<a class="button primary" href="/docs/#start">Start with Yazelix</a>
							<a class="button secondary" href="/docs/">Read the docs</a>
						</div>
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<div class="section-heading-row">
							<div>
								<p class="eyebrow">Workspace</p>
								<h2 id="workspace"><a class="feature-section-link" href="#workspace">One composition</a></h2>
								<p class="section-lede">
									Yazi, the editor, shells, and the Nova bar in one keyboard-driven session
								</p>
							</div>
						</div>
						<div class="feature-gallery">
							<FeatureMediaFrame item={workspaceStill} />
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-inner">
						<div class="section-heading-row">
							<div>
								<p class="eyebrow">{paneClips.length} clips</p>
								<h2 id="projects-and-panes">
									<a class="feature-section-link" href="#projects-and-panes">Projects and panes</a>
								</h2>
								<p class="section-lede">
									Tabs hold projects. The default stack keeps files beside shells. See the{' '}
									<a href="/blog/yazelix-nova-v1/">historical Nova v1 tour</a>
								</p>
							</div>
						</div>
						<div class="feature-gallery">
							{paneClips.map((clip) => <HomeWatchClip clip={clip} />)}
						</div>
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<div class="section-heading-row">
							<div>
								<p class="eyebrow">{popupClips.length} clips</p>
								<h2 id="popup-tools"><a class="feature-section-link" href="#popup-tools">Popup tools</a></h2>
								<p class="section-lede">
									Summon a tool over the workspace, then hide it. The tiled session stays put
								</p>
							</div>
						</div>
						<div class="feature-gallery">
							{popupClips.map((clip) => <HomeWatchClip clip={clip} />)}
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-inner">
						<h2 id="nova-and-zellij">
							<a class="feature-section-link" href="#nova-and-zellij">If you already know Zellij</a>
						</h2>
						<p class="section-lede">
							Tabs, stacked panes, and floating panes are Zellij. The sidebar layout, popups, top bar,
							and <code>yzx</code> are Yazelix. The Nova Zellij fork keeps upstream Zellij and adds Yazi
							image previews, session appearance, stable stack order, and a few plugin seams. See{' '}
							<a href="/docs/nova-and-zellij/">Nova and Zellij</a>
						</p>
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<h2 id="named-sessions">
							<a class="feature-section-link" href="#named-sessions">Named sessions</a>
						</h2>
						<p class="section-lede">
							<code>yzx launch</code> opens Nova Rio, then the workspace.{' '}
							<code>yzx enter</code> uses the current terminal or SSH. Add{' '}
							<code>--session NAME</code> to name that live session for attachment; project workspaces remain
							tabs inside it. Steps are in{' '}
							<a href="/docs/#start-named-sessions">Start</a>
						</p>
					</div>
				</section>
			</main>
			<SiteFooter />
		</div>
	</body>
</html>
