---
import { getEntry, render } from 'astro:content';
import PrefixedDocsContent from '../../components/PrefixedDocsContent.astro';
import SiteHead from '../../components/SiteHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import '../../styles/docs.css';

const docsOrder = [
	'start',
	'configure',
	'keybindings',
	'update',
	'recover',
	'docs/runtime-model',
	'docs/nova-and-zellij',
	'docs/customization-surfaces',
	'docs/troubleshooting-checklist',
];

const sections = await Promise.all(
	docsOrder.map(async (id) => {
		const entry = await getEntry('docs', id);

		if (!entry) {
			throw new Error(`Missing docs entry: ${id}`);
		}

		const { Content, headings } = await render(entry);
		const anchor = entry.id.replaceAll('/', '-');

		return {
			entry,
			Content,
			anchor,
			headings: headings.map((heading) => ({ ...heading, anchor: `${anchor}-${heading.slug}` })),
		};
	}),
);
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<SiteHead
			title="Yazelix Nova Docs"
			description="Yazelix Nova documentation for Stable installation, configuration, keybindings, updates, recovery, runtime behavior, and customization."
		/>
	</head>
	<body>
		<div class="page-shell">
			<SiteNav active="docs" />

			<main id="main-content" class="docs-page" tabindex="-1">
				<section class="docs-hero">
					<div class="docs-hero-inner">
						<h1>Yazelix Nova docs</h1>
					</div>
				</section>

				<div class="docs-shell">
					<aside class="docs-rail" aria-label="Docs navigation">
						<nav>
							<span>Docs</span>
							{
								sections.map((section, index) => (
									<div class="docs-rail-section">
										<a
											class="docs-rail-section-link"
											href={`#${section.anchor}`}
											data-docs-rail-link={section.anchor}
											data-docs-rail-section={section.anchor}
										>
											<small>{String(index + 1).padStart(2, '0')}</small>
											{section.entry.data.title}
										</a>
										<div class="docs-rail-subsections">
											{section.headings
												.filter((heading) => heading.depth === 2)
												.map((heading) => (
													<a
														class="docs-rail-subsection"
														href={`#${heading.anchor}`}
														data-docs-rail-link={heading.anchor}
														data-docs-rail-section={section.anchor}
													>
														{heading.text}
													</a>
												))}
										</div>
									</div>
								))
							}
						</nav>
					</aside>

					<div class="docs-stream">
						{
							sections.map((section, index) => (
								<section class="docs-chapter" id={section.anchor}>
									<header class="docs-chapter-header">
										<p>{String(index + 1).padStart(2, '0')}</p>
										<h2>{section.entry.data.title}</h2>
										<span>{section.entry.data.description}</span>
										<a href={`/${section.entry.id}/`}>Standalone page</a>
									</header>
									<div class="docs-markdown">
										<PrefixedDocsContent headings={section.headings}>
											<section.Content />
										</PrefixedDocsContent>
									</div>
								</section>
							))
						}
					</div>
				</div>
			</main>
		</div>
		<script>
			const rail = document.querySelector<HTMLElement>('.docs-rail');
			const railLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-docs-rail-link]'));
			const compactRail = window.matchMedia('(max-width: 920px)');
			const docTargets = railLinks.flatMap((link) => {
				const id = link.dataset.docsRailLink;
				const element = id && document.getElementById(id);
				return id && element ? [{ id, element }] : [];
			});

			function setActiveDocsSection(activeId: string) {
				const activeLink = railLinks.find((link) => link.dataset.docsRailLink === activeId);
				const activeSection = activeLink?.dataset.docsRailSection ?? activeId;

				for (const link of railLinks) {
					const isExactActive = link.dataset.docsRailLink === activeId;
					const isParentActive =
						link.classList.contains('docs-rail-section-link') &&
						link.dataset.docsRailSection === activeSection;
					const isCurrent = compactRail.matches ? isParentActive : isExactActive;

					if (isCurrent) link.setAttribute('aria-current', 'location');
					else link.removeAttribute('aria-current');
					link.classList.toggle('is-parent-active', !isExactActive && isParentActive);
				}

				const currentLink = compactRail.matches
					? railLinks.find((link) => link.dataset.docsRailLink === activeSection)
					: activeLink;
				if (!rail || !currentLink) return;

				const railRect = rail.getBoundingClientRect();
				const linkRect = currentLink.getBoundingClientRect();

				rail.scrollBy({
					left:
						linkRect.left < railRect.left + 16
							? linkRect.left - railRect.left - 16
							: Math.max(0, linkRect.right - railRect.right + 16),
					top:
						linkRect.top < railRect.top + 16
							? linkRect.top - railRect.top - 16
							: Math.max(0, linkRect.bottom - railRect.bottom + 16),
				});
			}

			function updateActiveDocsSection() {
				const scrollBottom = window.scrollY + window.innerHeight;
				const documentBottom = document.documentElement.scrollHeight;
				const isAtPageBottom = scrollBottom >= documentBottom - 8;
				const targetLine = window.innerHeight * (isAtPageBottom ? 0.7 : 0.34);
				let activeId = docTargets[0]?.id;

				for (const target of docTargets) {
					if (target.element.getBoundingClientRect().top <= targetLine) {
						activeId = target.id;
					}
				}

				if (activeId) setActiveDocsSection(activeId);
			}

			let scrollUpdatePending = false;
			function queueActiveDocsSectionUpdate() {
				if (scrollUpdatePending) return;

				scrollUpdatePending = true;
				requestAnimationFrame(() => {
					scrollUpdatePending = false;
					updateActiveDocsSection();
				});
			}

			updateActiveDocsSection();
			window.addEventListener('scroll', queueActiveDocsSectionUpdate, { passive: true });
			window.addEventListener('resize', queueActiveDocsSectionUpdate);
		</script>
	</body>
</html>
