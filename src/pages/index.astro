---
import HomeWatchStage from '../components/HomeWatchStage.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { homeLiveClips, homeWatchClips } from '../data/home_watch';
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Nova - Nix-packaged terminal workspace"
			description="Yazelix Nova is a Nix-packaged terminal workspace with Mars, Yazelix Zellij, Yazi, managed Helix, and one yzx front door."
		/>
	</head>
	<body>
		<div class="page-shell">
			<header class="hero compact-hero">
				<SiteNav active="home" />
				<div class="hero-content">
					<p class="eyebrow">Mars, Yazelix Zellij, Yazi, managed Helix, and Nushell in one Nix package</p>
					<h1>Yazelix Nova</h1>
					<p class="hero-copy">
						A Nix-packaged keyboard workspace for people who want files, editor, shells, and popup tools
						without assembling a multiplexer. Launch through Mars or enter from a capable terminal or SSH
						session.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/start/">Start with Yazelix</a>
						<a class="button secondary" href="/features/">See features</a>
						<a class="button secondary" href="/docs/">Read docs</a>
					</div>
				</div>
				<div class="hero-visual">
					<img
						src="/images/nova_workspace.png"
						alt="Yazelix Nova workspace with Yazi, Helix, shell, and runtime status"
						width="1920"
						height="1080"
						fetchpriority="high"
					/>
				</div>
			</header>

			<main id="main-content" tabindex="-1">
				<section class="section strip">
					<div class="section-inner">
						<h2>Install Stable</h2>
						<p class="section-lede">
							Add the checked release to your Nix profile, then run <code>yzx launch</code> for Mars or <code>yzx enter</code> in the current terminal.
						</p>
						<div class="terminal">
							<div class="terminal-header">install</div>
							<pre><code>nix profile add --refresh github:Yazelix/nova/stable</code></pre>
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-inner">
						<h2>Popup tools</h2>
						<p class="section-lede">
							Files, git, and the agent open over the workspace, then hide.
							<a href="/features/">See them on Features</a>.
						</p>
						<HomeWatchStage clips={homeWatchClips} groupLabel="Popup clips" />
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<h2>Panes, appearance, Anima</h2>
						<p class="section-lede">
							The tiled session rearranges. Ratconfig flips dark and light. Anima fills the workspace.
							<a href="/features/">See them on Features</a>.
						</p>
						<HomeWatchStage clips={homeLiveClips} groupLabel="Workspace clips" />
					</div>
				</section>

				<section class="section">
					<div class="section-inner">
						<h2>Move with h j k l</h2>
						<p class="section-lede">
							Nova extends Helix and Vim motion across the workspace. Alt focuses. Ctrl Alt moves. Alt
							Shift summons. The full map is in <a href="/keybindings/">Keybindings</a>.
						</p>
						<div class="hjkl-wrap">
							<table class="hjkl-grid">
								<thead>
									<tr>
										<th scope="col">Layer</th>
										<th scope="col"><kbd>h</kbd></th>
										<th scope="col"><kbd>j</kbd></th>
										<th scope="col"><kbd>k</kbd></th>
										<th scope="col"><kbd>l</kbd></th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<th scope="row"><kbd>Alt</kbd></th>
										<td>Focus left or previous tab</td>
										<td>Focus down</td>
										<td>Focus up</td>
										<td>Focus right or next tab</td>
									</tr>
									<tr>
										<th scope="row"><kbd>Ctrl Alt</kbd></th>
										<td>Move tab left</td>
										<td>Move pane down</td>
										<td>Move pane up</td>
										<td>Move tab right</td>
									</tr>
									<tr>
										<th scope="row"><kbd>Alt Shift</kbd></th>
										<td>Yazi sidebar</td>
										<td>Git popup</td>
										<td>Config popup</td>
										<td>Agent popup</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</section>
			</main>

			<SiteFooter />
		</div>
	</body>
</html>
