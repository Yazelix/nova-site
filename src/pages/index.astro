---
import FeatureMediaFrame from '../components/FeatureMediaFrame.astro';
import GitHubLink from '../components/GitHubLink.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import { featureItemsById, homepageFeatureIds } from '../data/feature_media';
import '../styles/home.css';

const itemsById = featureItemsById();
const homepageFeatures = homepageFeatureIds
	.map((id) => itemsById.get(id))
	.filter((item): item is NonNullable<typeof item> => item !== undefined);
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Nova - Nix-packaged terminal workspace"
			description="Yazelix Nova is a Nix-packaged terminal workspace with Mars, Yazelix Zellij, Yazi, managed Helix, and one yzx front door."
		/>
	</head>
	<body>
		<div class="page-shell">
			<header class="hero compact-hero">
				<SiteNav active="home" />
				<div class="hero-visual">
					<img
						src="/images/nova_workspace.png"
						alt="Yazelix Nova workspace with Yazi, Helix, shell, and runtime status"
						width="1864"
						height="1012"
						fetchpriority="high"
					/>
				</div>
				<div class="hero-content">
					<p class="eyebrow">Mars, Yazelix Zellij, Yazi, managed Helix, and Nushell in one Nix package</p>
					<h1>Yazelix Nova</h1>
					<p class="hero-copy">
						A keyboard-driven workspace with a managed Yazi sidebar, editor and shell panes, popup tools,
						and the <code>yzx</code> command. Launch through Mars or enter from a capable terminal or SSH session.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/start/">Start with Yazelix</a>
						<a class="button secondary" href="/features/">See features</a>
						<a class="button secondary" href="/docs/">Read docs</a>
					</div>
				</div>
			</header>

			<main id="main-content" tabindex="-1">
				<section class="section strip">
					<div class="section-inner">
						<h2>Install Stable</h2>
						<p class="section-lede">
							Add the checked release to your Nix profile, then run <code>yzx launch</code> for Mars or
							<code>yzx enter</code> in the current terminal.
						</p>
						<div class="terminal" aria-label="Yazelix install command">
							<div class="terminal-header">install</div>
							<pre><code>nix profile add --refresh github:Yazelix/nova/stable</code></pre>
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-inner">
						<h2>Watch what it does</h2>
						<p class="section-lede">
							The product tour focuses on the parts visible in the maintained Nova workspace: file navigation,
							runtime identity, and the keyboard map.
						</p>
						<div class="feature-preview-grid">
							{homepageFeatures.map((item) => <FeatureMediaFrame item={item} compact />)}
						</div>
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<h2>Use docs for exact steps</h2>
						<p class="section-lede">
							Docs are for install commands, settings, update paths, recovery, keybindings, and reference
							details. The feature tour is for seeing the workspace.
						</p>
						<div class="blog-grid">
							<article class="panel">
								<h3>Features</h3>
								<p>One maintained Nova workspace with focused views of files, runtime status, and controls.</p>
								<a href="/features/">View tour</a>
							</article>
							<article class="panel">
								<h3>Docs</h3>
								<p>Install, configure, update, recover, keybindings, and reference material.</p>
								<a href="/docs/">Docs index</a>
							</article>
							<article class="panel">
								<h3>Blog</h3>
								<p>No articles yet. Yazelix Nova v1 will be the first subject.</p>
								<a href="/blog/">Blog</a>
							</article>
						</div>
					</div>
				</section>
			</main>

			<footer class="footer">
				<div class="footer-inner">
					<span>Yazelix is built by Lucca Huguet</span>
					<GitHubLink label="github.com/Yazelix/nova" class="footer-github-link" showLabel />
				</div>
			</footer>
		</div>
	</body>
</html>
