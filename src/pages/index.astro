---
import HomeWatchStage from '../components/HomeWatchStage.astro';
import GitHubLink from '../components/GitHubLink.astro';
import SiteHead from '../components/SiteHead.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/home.css';
---

<!doctype html>
<html lang="en">
	<head>
		<SiteHead
			title="Yazelix Nova - Nix-packaged terminal workspace"
			description="Yazelix Nova is a Nix-packaged terminal workspace with Mars, Yazelix Zellij, Yazi, managed Helix, and one yzx front door."
		/>
	</head>
	<body>
		<div class="page-shell">
			<header class="hero compact-hero">
				<SiteNav active="home" />
				<div class="hero-content">
					<p class="eyebrow">Mars, Yazelix Zellij, Yazi, managed Helix, and Nushell in one Nix package</p>
					<h1>Yazelix Nova</h1>
					<p class="hero-copy">
						A keyboard-driven workspace with a managed Yazi sidebar, editor and shell panes, popup tools,
						and the <code>yzx</code> command. Launch through Mars or enter from a capable terminal or SSH session.
					</p>
					<div class="hero-actions">
						<a class="button primary" href="/start/">Start with Yazelix</a>
						<a class="button secondary" href="/features/">See features</a>
						<a class="button secondary" href="/docs/">Read docs</a>
					</div>
				</div>
				<div class="hero-visual">
					<img
						src="/images/nova_workspace.png"
						alt="Yazelix Nova workspace with Yazi, Helix, shell, and runtime status"
						width="1920"
						height="1080"
						fetchpriority="high"
					/>
				</div>
			</header>

			<main id="main-content" tabindex="-1">
				<section class="section strip">
					<div class="section-inner">
						<h2>Install Stable</h2>
						<p class="section-lede">
							Add the checked release to your Nix profile, then run <code>yzx launch</code> for Mars or <code>yzx enter</code> in the current terminal.
						</p>
						<div class="terminal">
							<div class="terminal-header">install</div>
							<pre><code>nix profile add --refresh github:Yazelix/nova/stable</code></pre>
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-inner">
						<h2>Watch what it does</h2>
						<p class="section-lede">
							Three moments from the v1 walkthrough.
							<a href="/features/">See them on Features</a>, or
							<a href="/blog/yazelix-nova-v1/">watch the full 54 seconds</a>.
						</p>
						<HomeWatchStage />
					</div>
				</section>

				<section class="section strip">
					<div class="section-inner">
						<h2>Use docs for exact steps</h2>
						<p class="section-lede">
							Docs are for install commands, settings, update paths, recovery, keybindings, and reference
							details. The feature tour is for seeing the workspace.
						</p>
						<div class="blog-grid">
							<article class="panel">
								<h3>Features</h3>
								<p>Short loops of tabs, panes, and config, plus one workspace in four views.</p>
								<a href="/features/">View tour</a>
							</article>
							<article class="panel">
								<h3>Docs</h3>
								<p>Install, configure, update, recover, keybindings, and reference material.</p>
								<a href="/docs/">Docs index</a>
							</article>
							<article class="panel">
								<h3>Blog</h3>
								<p>The terminal workspace behind yzx, and how Nova v1 is put together.</p>
								<a href="/blog/yazelix-nova-v1/">Read the article</a>
							</article>
						</div>
					</div>
				</section>
			</main>

			<footer class="footer">
				<div class="footer-inner">
					<span>Yazelix is built by Lucca Huguet</span>
					<GitHubLink label="github.com/Yazelix/nova" class="footer-github-link" showLabel />
				</div>
			</footer>
		</div>
	</body>
</html>
