---
import { novaWorkspaceAsset, type FeatureMediaItem } from '../data/feature_media';

const { item, compact = false } = Astro.props as {
	item: FeatureMediaItem;
	compact?: boolean;
};

const mediaClass = compact ? 'feature-media compact' : 'feature-media';
---

<figure class={mediaClass}>
	<div class:list={['feature-media-frame', `focus-${item.focus}`]}>
		<img
			src={novaWorkspaceAsset}
			alt={item.title}
			width="1864"
			height="1012"
			loading="lazy"
			decoding="async"
		/>
	</div>
	<figcaption>
		<strong>{item.title}</strong>
		<span>{item.summary}</span>
		{item.docsHref && <a href={item.docsHref}>Docs</a>}
	</figcaption>
</figure>
